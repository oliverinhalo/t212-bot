# t212-bot configuration. Copy to config.yaml and edit.
# Secrets live in .env, never here. This file is safe to commit if you want;
# .gitignore excludes config.yaml by default in case you put account notes in it.

capital:
  # Hard ceiling on total capital under management, in GBP.
  # No buy may leave (cash spent + position value) above this.
  max_capital_gbp: 400.00

  # No single position may exceed this % of max_capital_gbp.
  # 2.5% of 400 = £10 — together with min_order_gbp below this brackets every
  # order into a £5-£10 micro-trade band, for frequent short-term trading.
  per_trade_cap_pct: 2.5

  # No single ticker's total holding may exceed this % of max_capital_gbp.
  # (per_trade_cap_pct limits one order; this limits the accumulated position.)
  # Left high relative to per_trade_cap_pct so several micro-buys can stack.
  max_position_pct: 25.0

  # Orders smaller than this are rejected rather than shrunk to dust.
  min_order_gbp: 5.00

  # Cash never spent, so a fill that slips slightly cannot overdraw the account.
  cash_buffer_gbp: 1.00

risk:
  # Circuit breaker: if today's total P&L (realised + unrealised) drops below
  # -(this % of max_capital_gbp), trading halts and stays halted until you run
  #   python -m t212bot.main --reset-breaker
  daily_loss_limit_pct: 25.0

  # Maximum orders placed per calendar day (Europe/London).
  max_trades_per_day: 50

  # Reject an AI proposal whose implied price differs from the last quote by
  # more than this %. Guards against stale/hallucinated prices.
  max_price_deviation_pct: 2.0

  # How long ago the bot may have *fetched* a quote and still trade on it. This
  # measures our own market data going stale (the feed stopped answering, a
  # cached quote is being reused), not how far behind the exchange the feed is.
  # 0 disables the check.
  max_quote_age_seconds: 1800

  # How far behind the market a quote's own exchange timestamp may be. Free
  # feeds (Yahoo) are delayed ~15 minutes as a matter of course, so a freshly
  # fetched LSE quote is always ~900s "old" by this measure — which used to
  # block every order (R07_QUOTE_STALE). 0 (the default) accepts a delayed
  # feed; set it to e.g. 900 to refuse to trade on one.
  max_quote_delay_seconds: 0

  # Proposals below this confidence are downgraded to hold.
  min_confidence: 0.10

  # true  — the AI may only act on the watch-list below (the allow-list).
  # false — the AI may name any Trading212 instrument. It is resolved against
  #         data/instruments.json (run `python -m scripts.list_instruments
  #         --refresh` once first), priced on demand via Yahoo, and converted to
  #         GBP. An unknown/invented ticker is still rejected.
  enforce_allowlist: false

execution:
  # market | limit. Limit orders are placed at the quote adjusted by
  # limit_offset_bps in the direction that helps you get filled.
  order_type: market
  limit_offset_bps: 25

  # Assumed adverse slippage when simulating a fill in paper mode.
  paper_slippage_bps: 10

  # When the market is closed, place a resting LIMIT order that waits for the
  # open instead of a market order the broker simply refuses. The limit sits
  # limit_offset_bps away from the last quote in the direction that helps it
  # fill, which also caps what an opening gap can cost you: a buy will not pay
  # above the limit, it just does not fill.
  # The --preorder CLI flag turns this on for one run without editing this file.
  preorder_when_closed: false
  # How long a pre-order rests at the broker: GOOD_TILL_CANCEL or DAY.
  # GOOD_TILL_CANCEL survives to the next session; DAY expires with today's.
  preorder_time_validity: GOOD_TILL_CANCEL

  # Order quantities are rounded DOWN to this many decimal places, so rounding
  # can only ever shrink an order. Set fractional: false for whole shares only.
  quantity_decimals: 6
  fractional: true

  # Abandon a cycle if the account/quote data used by the risk check is older
  # than this by the time we are ready to submit.
  max_decision_age_seconds: 120

schedule:
  # Standard 5-field cron. Local time in the timezone below.
  # Every 10 minutes during market hours — short-term/high-turnover trading.
  cron: "*/10 8-16 * * mon-fri"
  timezone: Europe/London

  # Skip cycles outside these local times (belt and braces with the cron above).
  market_open: "08:05"
  market_close: "16:25"
  trading_days: [mon, tue, wed, thu, fri]

kill_switch:
  # If this file exists at the start of a cycle, the cycle halts cleanly.
  # `touch STOP` to stop the bot without stopping the service.
  stop_file: ./STOP

ai:
  # omniroute | auto | openrouter | anthropic | stub
  #   omniroute — DEFAULT. Self-hosted/private OpenAI-compatible router (unmetered).
  #   auto      — omniroute if OMNIROUTE_API_KEY is set, else anthropic, else openrouter.
  #   stub      — deterministic "hold", for testing the pipeline with no API calls.
  provider: omniroute
  timeout_seconds: 60
  # Reasoning models spend most of this thinking before writing a single
  # character of the answer. Too small and the JSON arrives cut off mid-field.
  max_tokens: 4096

  # Stop calling OpenRouter after this many HTTP calls in a UTC day (free tier
  # is ~50/day). Past this the local rule-based strategy takes over.
  # OpenRouter ONLY — OmniRoute (self-hosted, unmetered) and Anthropic
  # (pay-as-you-go) are never metered by this. 0 means no limit at all.
  daily_request_budget: 45
  # On model failure / spent budget, use the local strategy instead of "hold".
  local_fallback: true
  # Skip the LLM when nothing material moved since a cycle that held.
  # Set false to not limit or skip AI calls (especially for unmetered OmniRoute).
  # --until-trade ignores this either way: a retry exists because nothing has
  # changed yet, so the model is asked on every attempt.
  skip_when_unchanged: false
  min_price_move_pct: 0.5

  openrouter:
    base_url: https://openrouter.ai/api/v1
    # Fallback chain, tried in order until one answers. Put openrouter/free
    # last — it auto-routes to whatever free model fits. Free-tier model slugs
    # change; re-check with a GET on /api/v1/models before relying on these.
    models:
      - nvidia/nemotron-3-super-120b-a12b:free
      - minimax/minimax-m3:free
      - nvidia/nemotron-3.5-lightning:free
      - openrouter/free
    model: openrouter/free   # used only if 'models' is omitted

  # OmniRoute — a self-hosted/private OpenAI-compatible router. Same wire
  # format as OpenRouter (model fallback chain, JSON-mode retry). Used only
  # when ai.provider is (or resolves to, via "auto") omniroute; the API key
  # comes from OMNIROUTE_API_KEY in .env.
  omniroute:
    # Can be overridden per-environment via OMNIROUTE_BASE_URL in .env
    # instead of editing this file (e.g. local vs a remote instance).
    base_url: https://omni.jacoblevy.co.uk/v1
    models:
      - auto/best-fast
      - auto/best-reasoning
      - auto/best-chat
    model: auto/best-fast   # used only if 'models' is omitted

  anthropic:
    model: claude-haiku-4-5

  # Days of daily closes shown to the model for each watch-list ticker.
  history_days: 30

  # Local technical analysis (no API cost): SMA/RSI/vol/momentum from the daily
  # closes, fed to the model and used by the local strategy.
  indicators:
    sma_short: 10
    sma_mid: 20
    sma_long: 50
    rsi_period: 14
    min_bars: 30
    lookback_days: 60

  # Deterministic fallback advisor. Percent values. One action per cycle:
  # stop-loss -> trend exit -> take-profit -> cautious entry -> hold.
  # Tuned for short-term/high-turnover micro-trading (tight stop, quick profit
  # take, and a much lower bar to enter a position).
  local_strategy:
    stop_loss_pct: 5.0
    trend_exit: true
    take_profit_pct: 4.0
    max_entry_vol_pct: 45.0
    min_entry_score: 0.15

market_data:
  # yahoo — free, no key. Uses the `yahoo` symbol from each watchlist entry.
  provider: yahoo
  timeout_seconds: 20
  # Cache quotes for this long so a retry inside one cycle does not refetch.
  cache_seconds: 60

  # Open-universe mode (risk.enforce_allowlist: false) only:
  fx_cache_seconds: 900       # how long a fetched GBP FX rate is cached
  symbol_search: true         # allow the Yahoo ISIN search when resolving a symbol
  symbol_overrides: {}        # pin a Yahoo symbol: <T212 ticker or ISIN>: <symbol>

storage:
  db_path: ./data/t212bot.sqlite3

logging:
  level: INFO
  file: ./data/t212bot.log

dashboard:
  host: 0.0.0.0
  port: 8080

# ---------------------------------------------------------------------------
# The allow-list. The AI can ONLY act on tickers listed here; anything else is
# rejected by risk_manager before it reaches the broker.
#
#   ticker — the EXACT Trading212 instrument ticker. Find it with:
#              python -m scripts.list_instruments VUSA
#            Do not guess; T212 tickers are not plain exchange symbols.
#   yahoo  — the Yahoo Finance symbol used for quotes and price history.
#   name   — human label, shown to the AI and in the dashboard.
#   max_position_pct — optional per-ticker override of capital.max_position_pct.
# ---------------------------------------------------------------------------
watchlist:
  - ticker: VUSAl_EQ
    yahoo: VUSA.L
    name: Vanguard S&P 500 UCITS ETF (GBP)

  - ticker: VWRPl_EQ
    yahoo: VWRP.L
    name: Vanguard FTSE All-World Acc (GBP)

  - ticker: ISFl_EQ
    yahoo: ISF.L
    name: iShares Core FTSE 100 UCITS ETF (GBP)
    max_position_pct: 20.0
