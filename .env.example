# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing in this file is ever written to the audit log or printed.

# ---------------------------------------------------------------------------
# Mode: paper | demo | live
#   paper — DEFAULT. Never calls an order endpoint at all. Reads real quotes
#           and simulates fills against a virtual ledger held in SQLite.
#   demo  — Places REAL orders against Trading212's demo (practice) account.
#           Fake money, real order endpoints. Use this to test execution.
#   live  — REAL MONEY. Also requires I_UNDERSTAND_THIS_IS_REAL_MONEY=yes.
# ---------------------------------------------------------------------------
MODE=paper

# Required only for MODE=live. Any value other than exactly "yes" refuses to start.
# I_UNDERSTAND_THIS_IS_REAL_MONEY=no

# ---------------------------------------------------------------------------
# Trading212 credentials — Settings -> API in the T212 app.
# Generate a SEPARATE key pair for demo and for live; do not reuse.
# ---------------------------------------------------------------------------
T212_API_KEY=
T212_API_SECRET=

# Auth scheme sent to Trading212: basic | header
#   basic  — Authorization: Basic base64(KEY:SECRET)   (documented key+secret pairs)
#   header — Authorization: <T212_API_KEY>             (older single-token keys)
# Run `python -m scripts.check_auth` after changing this; it reports which works.
T212_AUTH_SCHEME=basic

# Optional base URL overrides (defaults are the documented demo/live hosts).
# T212_DEMO_BASE_URL=https://demo.trading212.com/api/v0
# T212_LIVE_BASE_URL=https://live.trading212.com/api/v0

# ---------------------------------------------------------------------------
# AI provider (OmniRoute preferred/default). Set OMNIROUTE_API_KEY to use
# OmniRoute; otherwise OPENROUTER_API_KEY for OpenRouter or ANTHROPIC_API_KEY for
# Anthropic. If none are set the bot refuses to start unless ai.provider is
# set to "stub" in config.yaml.
# ---------------------------------------------------------------------------
OMNIROUTE_API_KEY=

# Optional override of ai.omniroute.base_url (defaults to https://omni.jacoblevy.co.uk/v1)
# OMNIROUTE_BASE_URL=https://omni.jacoblevy.co.uk/v1

# OpenRouter key (fallback/alternative provider)
OPENROUTER_API_KEY=

# If this is set, it can be selected via ai.provider: anthropic (or auto)
# ANTHROPIC_API_KEY=

# Optional, sent to OpenRouter for attribution/leaderboards only.
# OPENROUTER_APP_URL=https://github.com/yourname/t212-bot
# OPENROUTER_APP_TITLE=t212-bot

# ---------------------------------------------------------------------------
# Paths (optional overrides; config.yaml normally sets these)
# ---------------------------------------------------------------------------
# T212BOT_CONFIG=./config.yaml
