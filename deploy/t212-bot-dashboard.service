[Unit]
Description=t212-bot dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python -m t212bot.dashboard
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=t212-bot-dashboard

# Read-only view; it only ever reads the SQLite file. WAL mode still needs
# write access to the -wal and -shm sidecars, hence ReadWritePaths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/data

[Install]
WantedBy=multi-user.target
